{
	"name": "@palebluebytes/google-cms",
	"version": "0.2.0",
	"description": "Use google services as a CMS system",
	"type": "module",
	"license": "MIT",
	"author": "Pale Blue Bytes",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/palebluebytes/google-cms.git"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"exports": {
		"./drive": {
			"types": "./dist/drive.d.ts",
			"default": "./dist/drive.js"
		},
		"./calendar": {
			"types": "./dist/calendar.d.ts",
			"default": "./dist/calendar.js"
		},
		"./auth": {
			"types": "./dist/auth.d.ts",
			"default": "./dist/auth.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "node --run clean && tsc",
		"typecheck": "tsc --noEmit && tsc -p test",
		"test": "node --test \"test/**/*.test.ts\"",
		"format": "prettier --write .",
		"prepack": "node --run build"
	},
	"keywords": [
		"google-drive",
		"google-calendar",
		"static-site-generator",
		"build-time",
		"eleventy",
		"astro",
		"gallery",
		"aspect-ratio",
		"zero-dependency"
	],
	"devDependencies": {
		"@types/node": "^26.2.0",
		"prettier": "^3.6.2",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@10.34.5"
}
